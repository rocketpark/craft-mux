{% import "_includes/forms" as forms %}
{% set ns = craft.app.view.getNamespace is not empty ? craft.app.view.getNamespace ~ "-" : ''  %}

{% set crumbs = [
    { label: "Mux", url: cpUrl('mux') },
    { label: "Assets", url: cpUrl('mux/assets') },
    { label: muxAsset.title }
] %}

{{ hiddenInput('elementType', 'rocketpark\\mux\\elements\\MuxAsset') }}

{{ forms.hidden({
    id:"asset_id",
    name:"asset_id",
    value: muxAsset.asset_id
}) }}

{{ forms.hidden({
    id: "meta-title",
    name: "meta[title]",
    value: muxAsset.title
}) }}

{{ forms.hidden({
    id: "meta-external_id",
    name: "meta[external_id]",
    value: muxAsset.id
}) }}

{{ forms.hidden({
    id: "meta-creator_id",
    name: "meta[creator_id]",
    value: currentSite.name
}) }}

{{ titleFieldHtml }}

<div id="mux-player-container-{{ muxAsset.id }}">
    {% if muxAsset.securePlayback %}
        {% set tokens = muxAsset.securePlaybackTokens %}
        {% if tokens|length >= 1 %}       
            {% set keyID = tokens[0]['key_id'] %} 
            {% set videoToken = muxAsset.getSecurePlaybackJWT(keyID) %}
            {% set thumbToken = muxAsset.getSecurePlaybackJWT(keyID, 't') %}
            {% set storyboardToken = muxAsset.getSecurePlaybackJWT(keyID, 's') %}
            <mux-player
                    id="mux-player-{{ muxAsset.id }}"
                style="aspect-ratio: 16/9;"
                accent-color="#cf3f40"
                stream-type="on-demand"
                metadata-video-id="{{ muxAsset.asset_id }}"
                metadata-video-title="{{ muxAsset.title }} (CraftCMS Entry)"
                playback-id="{{ muxAsset.playback_ids[0].id }}"
                playback-token="{{ videoToken }}"
                thumbnail-token="{{ thumbToken }}",
                storyboard-token="{{ storyboardToken }}"
                disable-cookies="true"
                default-hidden-captions="true"
                title="{{ muxAsset.title }}"
            ></mux-player>
        {% else %}
            <h3>{{ "Must create Signed Keys to playback this video and view thumbnails."|t('mux') }}</h3>
        {% endif %}
    {% else %}
        <mux-player
                id="mux-player-{{ muxAsset.id }}"
            style="aspect-ratio: 16/9;"
            accent-color="#cf3f40"
            stream-type="on-demand"
            metadata-video-id="{{ muxAsset.asset_id }}"
            metadata-video-title="{{ muxAsset.title }} (CraftCMS Entry)"
            playback-id="{{ muxAsset.playback_ids[0].id }}"
            disable-cookies="true"
            default-hidden-captions="true"
            title="{{ muxAsset.title }}"></mux-player>
    {% endif %}
</div>

{% js at endBody %}
    $(function() {
        $("#{{ ns }}title").on('input', function() {
            $("#{{ ns }}meta-title").val($(this).val());
        });

        $("#{{ ns }}mux-player-container-{{ muxAsset.id }}").find('mux-player').each(function() {
            const player = $(this)[0];
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.target === player) {
                        if (!entry.isIntersecting) {
                            player.pause();
                        }
                    }
                });
            }, {
                threshold: 0.5  // 50% of the player should be visible to trigger the observer
            });
            observer.observe(player);
        });

        /* Mux asset update checker */

        // Store initial dateUpdated in UTC format
        window.muxLastDateUpdated = new Date("{{ muxAsset.dateUpdated.format('c') }}").toISOString();
        
        // Check for element updates every 5 seconds
        const muxUpdateInterval = setInterval(async function() {
            try {
                const response = await fetch("/actions/mux/assets/use-asset-element-by-id?id={{ muxAsset.id }}", {
                    headers: {
                        "Accept": "application/json",
                        "X-Requested-With": "XMLHttpRequest",
                        "X-CSRF-Token": "{{ craft.app.request.csrfToken }}"
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    const currentDateUpdated = data.dateUpdated;
                    const lastDateUpdated = window.muxLastDateUpdated;
                    
                    // Normalize both dates to UTC for comparison
                    const currentUTC = new Date(currentDateUpdated).toISOString();
                    const lastUTC = new Date(lastDateUpdated).toISOString();
                    
                    if (currentUTC !== lastUTC) {
                        window.muxLastDateUpdated = currentUTC;
                        
                        // Create the Reload button using Craft's UI components
                        const $reloadBtn = Craft.ui.createButton({
                            label: Craft.t('app', 'Reload'),
                            spinner: true,
                        });

                        Craft.cp.displayNotice(Craft.t('mux', 'This Mux asset has been updated by a webhook. Please reload to see the latest changes.'), {
                            details: $reloadBtn,
                        });

                        $reloadBtn.on('click', () => {
                            window.location.reload();
                        });

                    }
                }
            } catch (error) {
                // Silent error handling
            }
        }, 5000);
        
        // Clean up interval when page unloads
        window.addEventListener("beforeunload", function() {
            if (muxUpdateInterval) {
                clearInterval(muxUpdateInterval);
            }
        });

    });
{% endjs %}
