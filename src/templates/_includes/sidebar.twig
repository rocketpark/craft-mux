{% import "_includes/forms" as forms %}
{% set ns = craft.app.view.getNamespace is not empty ? craft.app.view.getNamespace ~ "-" : ''  %}
<legend class="h6">{{ "MUX Asset Details"|t('mux') }}</legend>
<fieldset style="margin-top:12px;">
    <div class="meta">
        <div class="data">
            
            <h5 class="heading">{{ "ID"|t('mux') }} </h5>
            <div class="value">
                <span class="info">{{ muxAsset.asset_id }}</span>
            </div>

            <h5 class="heading">{{ "Status:"|t('mux') }} </h5>
            <div class="value">
                {% set color = 'gray' %}
                {% switch muxAsset.asset_status %}
                    {% case 'ready' %}
                        {% set color = 'teal' %}
                    {% case 'processing' %}
                        {% set color = 'purple' %}
                    {% case 'error' %}
                        {% set color = 'red' %}
                    {% case 'deleting' %}
                        {% set color = 'orange' %}
                    {% case 'deleted' %}
                        {% set color = 'gray' %}
                {% endswitch %}
                <span class="status-label {{ color }}"><span class="status {{ color }}"></span><span class="status-label-text">{{ muxAsset.asset_status }}</span></span>
            </div>

            {% if muxAsset.duration is defined and muxAsset.duration is not empty %} 
                <h5 class="heading">{{ "Duration:"|t('mux') }}</h5>
                <div class="value flex">
                    {% set totalSeconds = muxAsset.duration %}
                    {% set hours = totalSeconds // 3600 %}
                    {% set minutes = (totalSeconds % 3600) // 60 %}
                    {% set seconds = totalSeconds % 60 %}
                    
                    {{ '%02d:%02d:%02d'|format(hours, minutes, seconds) }}
                </div>
            {% endif %}

            <h5 class="heading">{{ "Playback IDs"|t('mux') }}</h5>
            <div class="value flex">
                {% for item in muxAsset.playback_ids %}
                    <div>
                        {{ item.policy }} <span class="info">{{ item.id }}</span>
                    </div>
                {% endfor %}
            </div>

            {% if muxAsset.aspect_ratio is defined %}
                <h5 class="heading">{{ "Aspect Ratio"|t('mux') }}</h5>
                <div class="value flex">
                    {{ muxAsset.aspect_ratio }}
                </div>
            {% endif %}
            
            {% if muxAsset.upload_id is defined %}            
                <h5 class="heading">{{ "Upload ID"|t('mux') }}</h5>
                <div class="value flex read-only">
                    <span class="info">{{ muxAsset.upload_id }}</span>
                </div>
            {% endif %}

            <h5 class="heading">{{ "Tracks"|t('mux') }}</h5>
            <div class="value flex">
                <ul>
                {% for item in muxAsset.tracks %}
                    {% switch item.type %}
                        {% case "audio" %}
                            {% if item.max_channel_layout is defined %}
                                {# TODO: Remove this once we have a new version of the API #}
                                <li>Audio {{ item.max_channel_layout }}</li>
                            {% elseif item.max_channels is defined %}
                                <li>Audio {{ item.max_channels }} channels</li>
                            {% endif %}
                        {% case "video" %}
                            {% if item.max_height is defined %}                                
                                <li>Video {{ item.max_height }}p</li>
                            {% endif %}
                        {% case "text" %}
                            {% if item.language_code is defined %}
                                <li>Text subtitles ({{ item.language_code }})</li>
                            {% endif %}
                    {% endswitch %}
                {% endfor %}
                </ul>
            </div>

            {% if muxAsset.static_renditions == null and (muxAsset.mp4_support != 'none' and muxAsset.mp4_support != null) %}
                <h5 class="heading">{{ "MP4 Support"|t('mux') }} 
                    <span class="info">{{ "Turn on static MP4, M4A, or both. (DEPRECATED). Use Static Renditions instead."|t('mux') }}</span>
                </h5>
                <div class="value flex">
                    <div class="select">
                        <select id="{{ ns }}mux-mp4-support" name="mp4_support">
                            <option value="none" {% if muxAsset.mp4_support == 'none' %}selected{% endif %}>None</option>
                            <option value="capped-1080p" {% if muxAsset.mp4_support == 'capped-1080p' %}selected{% endif %}>Capped 1080p</option>
                            <option value="audio-only" {% if muxAsset.mp4_support == 'audio-only' %}selected{% endif %}>Audio Only</option>
                            <option value="capped-1080p,audio-only" {% if muxAsset.mp4_support == 'capped-1080p,audio-only' %}selected{% endif %}>Capped 1080p,Audio Only</option>
                        </select>
                    </div>
                </div>
            {% endif %}

            {% if muxAsset.static_renditions == null and (muxAsset.mp4_support != 'none' and muxAsset.mp4_support != null) %}
                <h5 class="heading">{{ "MP4 Support Status"|t('mux') }}</h5>
                <div class="value flex">
                    {% set colors = {
                        'ready': 'teal',
                        'preparing': 'purple',
                        'errored': 'red',
                        'disabled': 'gray'
                    } %}
                    {% set status = muxAsset.static_renditions.status %}
                    {% set color = colors[status] ?? 'gray' %}
                    <span class="status-label {{ color }}"><span class="status {{ color }}"></span><span class="status-label-text">{{ status }}</span></span>
                </div>
            {% endif %}

            <h5 class="heading">{{ "Static Renditions"|t('mux') }}
                <span class="info">{{ "Enable static renditions for offline viewing and direct downloads. Select one or more resolutions. \"Highest\" is mutually exclusive with specific resolutions. To switch types (e.g. Highest to 1080p), first uncheck and save to delete, then select the new resolution and save again. Note static renditions will not upscale."|t('mux') }}</span>
            </h5>
            <div class="value flex">
                {% set renditionOptions = craft.muxRenditionOptions %}

                {# Determine source video max_height for upscale prevention #}
                {% set sourceMaxHeight = null %}
                {% for track in muxAsset.tracks %}
                    {% if track.type == 'video' and track.max_height is defined %}
                        {% set sourceMaxHeight = track.max_height %}
                    {% endif %}
                {% endfor %}

                {% set resolutionHeights = {
                    '2160p': 2160, '1440p': 1440, '1080p': 1080,
                    '720p': 720, '540p': 540, '480p': 480, '360p': 360, '270p': 270
                } %}

                {# Build a resolution => file-object map for all currently active renditions #}
                {% set activeRenditions = {} %}
                {% if muxAsset.static_renditions.files is defined %}
                    {% for file in muxAsset.static_renditions.files %}
                        {% if file.status != 'deleted' %}
                            {% set activeRenditions = activeRenditions|merge({ (file.resolution): file }) %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {# Hidden sentinel ensures the key is always present in POST, even when nothing is checked #}
                <input type="hidden" name="static_renditions" value="">

                <div class="checkbox-group" id="{{ ns }}mux-static-renditions">
                    {% for value, label in renditionOptions %}
                        {% set isUpscale = sourceMaxHeight is not null and resolutionHeights[value] is defined and resolutionHeights[value] > sourceMaxHeight %}
                        <div class="checkboxfield">
                            <input type="checkbox"
                                   id="{{ ns }}mux-static-rendition-{{ value }}"
                                   name="static_renditions[]"
                                   value="{{ value }}"
                                   {% if value in activeRenditions|keys %}checked{% endif %}
                                   {% if isUpscale %}disabled title="{{ 'Upscaling not allowed — source is %sp'|t('mux', {'%s': sourceMaxHeight}) }}"{% endif %}>
                            <label for="{{ ns }}mux-static-rendition-{{ value }}"{% if isUpscale %} style="opacity:0.4"{% endif %}>{{ label }}</label>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if activeRenditions|length > 0 %}
                <h5 class="heading">{{ "Static Renditions Status"|t('mux') }}</h5>
                <div class="value flex" id="{{ ns }}static-rendition-status">
                    {% set colors = {
                        'ready':     'teal',
                        'preparing': 'purple',
                        'errored':   'red',
                        'disabled':  'gray',
                    } %}
                    {% for resolution, file in activeRenditions %}
                        <div data-static-rendition-id="{{ file.id ?? '' }}" data-resolution="{{ resolution }}" style="margin-bottom:4px;">
                            <span style="margin-right:6px;">{{ renditionOptions[resolution] ?? resolution }}:</span>
                            {% set color = colors[file.status] ?? 'gray' %}
                            <span class="status-label {{ color }}">
                                <span class="status {{ color }}"></span>
                                <span class="status-label-text">{{ file.status }}</span>
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <h5 class="heading">
                {{ "Meta"|t('mux') }}
            </h5>
            <div class="value flex">
                <span class="info">
                    <span class="h6">Title:</span> {{  muxAsset.meta['title'] ?? muxAsset.title }}<br>
                    <span class="h6">External ID:</span> {{  muxAsset.meta['external_id'] ?? muxAsset.id }}<br>
                    <span class="h6">Creator ID:</span> {{ muxAsset.meta['creator_id'] ?? '' }}
                </span>
            </div>

        </div>
    </div>
</fieldset>

{% js at endBody %}

    $(function() {
        var mp4SupportSelect = $("#{{ ns }}mux-mp4-support");
        var staticRenditionsGroup = $("#{{ ns }}mux-static-renditions");
        var specificResolutions = {{ craft.muxSpecificResolutions|json_encode|raw }};
        var sourceMaxHeight = {{ sourceMaxHeight is not null ? sourceMaxHeight : 'null' }};
        var resolutionHeights = { '2160p': 2160, '1440p': 1440, '1080p': 1080, '720p': 720, '540p': 540, '480p': 480, '360p': 360, '270p': 270 };

        function getCheckbox(value) {
            return staticRenditionsGroup.find('input[type="checkbox"][value="' + value + '"]');
        }

        function isUpscaleDisabled(value) {
            return sourceMaxHeight !== null && resolutionHeights[value] !== undefined && resolutionHeights[value] > sourceMaxHeight;
        }

        function anySpecificChecked() {
            return specificResolutions.some(function(r) { return getCheckbox(r).is(':checked'); });
        }

        // Resolutions confirmed active in the DB right now (not just checked this session)
        var activeFromDB = {{ activeRenditions|keys|json_encode|raw }};
        var highestActiveFromDB = activeFromDB.indexOf('highest') !== -1;
        var specificActiveFromDB = specificResolutions.some(function(r) {
            return activeFromDB.indexOf(r) !== -1;
        });

        function enforceHighestMutualExclusivity(changedValue) {
            if (changedValue === 'highest') {
                var highestChecked = getCheckbox('highest').is(':checked');
                specificResolutions.forEach(function(r) {
                    var cb = getCheckbox(r);
                    if (highestChecked) {
                        // Highest just checked — disable all specific
                        cb.prop('checked', false).prop('disabled', true);
                    } else if (highestActiveFromDB) {
                        // Highest came FROM DB — two-step required, keep specific disabled
                        cb.prop('disabled', true);
                    } else {
                        // Highest was checked this session then unchecked — re-enable specific (unless upscale-disabled)
                        cb.prop('disabled', isUpscaleDisabled(r));
                    }
                });
            } else if (specificResolutions.indexOf(changedValue) !== -1) {
                var highestCb = getCheckbox('highest');
                if (anySpecificChecked()) {
                    highestCb.prop('checked', false).prop('disabled', true);
                } else if (specificActiveFromDB) {
                    // A specific came FROM DB — two-step required, keep highest disabled
                    highestCb.prop('disabled', true);
                } else {
                    highestCb.prop('disabled', false);
                }
            }
        }

        // Apply correct disabled state on page load based on asset's current renditions
        function initMutualExclusivity() {
            if (getCheckbox('highest').is(':checked')) {
                specificResolutions.forEach(function(r) { getCheckbox(r).prop('disabled', true); });
            } else if (anySpecificChecked()) {
                getCheckbox('highest').prop('disabled', true);
            }
        }
        initMutualExclusivity();

        staticRenditionsGroup.on('change', 'input[type="checkbox"]', function() {
            enforceHighestMutualExclusivity($(this).val());

            // MP4 Support mutual exclusivity
            var mp4Val = mp4SupportSelect.val();
            if (mp4Val && mp4Val !== 'none' && staticRenditionsGroup.find('input[type="checkbox"]:checked').length > 0) {
                Craft.cp.displayError(Craft.t("mux", "Static renditions can only be set if MP4 Support is set to 'None'."));
                staticRenditionsGroup.find('input[type="checkbox"]').prop('checked', false);
                initMutualExclusivity();
            }
        });

        // When MP4 Support changes to a non-'none' value, reset it if renditions are checked
        mp4SupportSelect.on('change', function() {
            if (mp4SupportSelect.val() !== 'none' && staticRenditionsGroup.find('input[type="checkbox"]:checked').length > 0) {
                Craft.cp.displayError(Craft.t("mux", "Static renditions can only be set if MP4 Support is set to 'None'. MP4 Support has been reset."));
                mp4SupportSelect.val('none');
            }
        });

        // Final guard on form submission
        $('form').on('submit', function(e) {
            var mp4Val = mp4SupportSelect.val();
            if (mp4Val && mp4Val !== 'none' && staticRenditionsGroup.find('input[type="checkbox"]:checked').length > 0) {
                Craft.cp.displayError(Craft.t("mux", "Static renditions can only be set if MP4 Support is set to 'None'."));
                e.preventDefault();
                return false;
            }
        });
    });

{% endjs %}