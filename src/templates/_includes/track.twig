{% import "_includes/forms" as forms %}
{% set id = id ?? false %}
{% set track = track ?? false %}
{% set asset_id = asset_id ?? false %}
{% set confirmMessage = "Are you sure you want to delete this track?"|t('mux') %}

<div class="mux-track {{ track.type == 'text' ? 'mux-track-text' : '' }}" id="mux-track-{{ track.id }}">
    <div class="mux-track-item">
        {% switch track.type %}
            {% case "text" %}
                <span>
                    <svg class='icon' width="24" height="24" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                </span> 
                <span>{{ "Text"|t('mux') }}</span> 
                <span>{{  track.name }}</span>
                {% if track.closed_captions is defined and track.closed_captions == true %}            
                    <span>{{ "subtitles"|t('mux') }}</span> 
                {% endif %}
                {% if track.language_code is defined and track.language_code is not empty %}            
                    <span>({{ track.language_code }})</span>
                {% endif %}
            {% case "audio" %}
                <span>
                    <svg class="icon" width="24" height="24" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
                    </svg>
                </span> 
                <span>{{ "Audio"|t('mux') }}</span> 
                {% if track.max_channel_layout is defined and track.max_channel_layout is not empty %}   
                    <span>{{ track.max_channel_layout }}</span>
                {% endif %}
            {% case "video" %}
                <span>
                    <svg class="icon" width="24" height="24" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                </span> 
                <span>{{ "Video"|t('mux') }}</span> 
                {% if track.max_height is defined and track.max_height is not empty %} 
                    <span>{{ track.max_height }}p</span>
                {% endif %}
        {% endswitch %}
    </div>
    
    {% if track.type == "text" %}
        <div class="mux-track-actions">
            {% if track.type == "text" %}
                {#  Download Track #}
                {% set useToken = muxAsset.securePlayback and muxAsset.securePlaybackTokens|length >= 1 %}
                {% set playbackId = muxAsset.playbackId() %}
                {% set videoToken = useToken ? muxAsset.getSecurePlaybackJWT(muxAsset.securePlaybackTokens[0]['key_id']) : null %}
                {% set downloadUrl = "https://stream.mux.com/#{playbackId}/text/#{track.id}.vtt" ~ (useToken ? "?token=#{videoToken}" : "") %}
                <a
                    class="error"
                    id="mux-track-download-{{ track.id }}"
                    href="{{ downloadUrl }}"
                    target="_blank"
                    rel="noopener"
                    title="{{ "Download Text Track"|t('mux') }}"
                    download="{{ muxAsset.title }}_{{ 'Text_Track'|t('mux') }}.vtt">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="xcircleicon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    <span class="sr-only">{{ "Download Text Track"|t('mux') }} {{ track.name  }}</span>
                </a>
            {% endif %}
            
            {# Delete Track - Available for all track types #}
            <button
                class="error"
                id="mux-track-delete-{{ track.id }}"
                data-asset-id="{{ asset_id }}"
                data-track-id="{{ track.id }}"
                data-confirm-message="{{ confirmMessage }}"
                title="{{ "Delete #{track.type|title} Track"|t('mux') }}"
                type="button"
                aria-label="{{ "Delete #{track.type|title} Track"|t('mux') }}"
            >
                <svg class="xcircleicon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="spinner hidden"></div>
                <span class="sr-only">{{ "Delete #{track.type|title} Track"|t('mux') }} {{ track.name is defined and track.name is not empty ? track.name : '' }}</span>
            </button>
        </div>
    {% endif %}
</div>
