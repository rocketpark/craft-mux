{# @var plugin \rocketpark\mux\Mux #}
{# @var settings \rocketpark\mux\models\Settings #}
{% requirePermission "mux:settings" %}

{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% from "mux/_includes/macros.twig" import configWarning %}

{% block content %}

    <input type="hidden" name="action" value="mux/settings/save-plugin-settings">
    <input type="hidden" name="pluginHandle" value="mux">

    {{ redirectInput("mux/settings") }}

    {% namespace "settings" %}
        
        {{ forms.textField({
            label: "Plugin name"|t("mux"),
            instructions: "The public-facing name of the plugin"|t("mux"),
            id: "pluginName",
            name: "pluginName",
            suggestEnvVars: true,
            value: settings.pluginName,
            warning: configWarning("pluginName", "mux"),
            errors: settings.getErrors("pluginName"),
        }) }}


        {{ forms.autosuggestField({
            label: "MUX Token Id"|t("mux"),
            instructions: "Mux Token Id generated in your [Mux account]('https://docs.mux.com/guides/video/stream-video-files#1-get-an-api-access-token')."|t("mux"),
            id: "muxTokenId",
            name: "muxTokenId",
            suggestEnvVars: true,
            value: settings.muxTokenId,
            warning: configWarning("muxTokenId", "mux"),
            errors: settings.getErrors("muxTokenId")
        }) }}


        {{ forms.autosuggestField({
            label: "MUX Token Secret"|t("mux"),
            instructions: "MUX Token Secret generated in your [Mux account]('https://docs.mux.com/guides/video/stream-video-files#1-get-an-api-access-token')."|t("mux"),
            id: "muxTokenSecret",
            name: "muxTokenSecret",
            suggestEnvVars: true,
            value: settings.muxTokenSecret,
            warning: configWarning("muxTokenSecret", "mux"),
            errors: settings.getErrors("muxTokenSecret"),
        }) }}

        {{ forms.selectizeField({
            label: "Max Resolution Tier"|t("mux"),
            id: 'maxResolutionTier',
            name: 'maxResolutionTier',
            options: [
                { label: '2160p (4k)', value: '2160p'},
                { label: '1440p (2k)', value: '1440p'},
                { label: '1080p', value: '1080p', selected: true },
                { label: '720p', value: '720p' }
            ],
            value: settings.maxResolutionTier,
            toggle: true,
            tip: 'Max resolution tier can be used to control the maximum `resolution_tier` your asset is encoded, stored, and streamed at. Defaults to `1080p`.'|t('mux'),
            includeEnvVars: true,
            allowedEnvValues: null,
        }) }}

        {% set mp4Instructions %}
            {{ "Enable static MP4 renditions on your video assets for offline viewing and other use cases. (DEPRECATED)"|t('mux') }}
            <a href="https://docs.mux.com/guides/enable-static-mp4-renditions" target="_blank">View Documentation</a>
        {% endset %}

        {{  forms.selectizeField({
            label: 'Default MP4 Support <div class="info">%s</div>'|format(mp4Instructions),
            id: 'mp4Support',
            name: 'mp4Support',
            options: [
                { label: 'None', value: 'none' },
                { label: 'Capped 1080p', value: 'capped-1080p' },
                { label: 'Audio Only', value: 'audio-only' },
                { label: 'Capped 1080p, Audio Only', value: 'capped-1080p,audio-only' }
            ],
            value: settings.mp4Support,
            includeEnvVars: true,
            allowedEnvValues: null,
            errors: settings.getErrors('mp4Support')
        }) }}

        {% set staticRenditionsInstructions %}
            {{ "Enable static renditions on your video assets for offline viewing and other use cases. Set MP4 Support to \"None\" to use Static Renditions."|t('mux') }}
            <a href="https://docs.mux.com/guides/enable-static-mp4-renditions" target="_blank">View Documentation</a>
        {% endset %}

        {{  forms.selectizeField({
            label: 'Default Static Renditions Support <div class="info">%s</div>'|format(staticRenditionsInstructions),
            id: 'staticRenditions',
            name: 'staticRenditions',
            options: [
                { label: 'None', value: 'none' },
                { label: 'Highest', value: 'highest' },
                { label: 'Audio Only', value: 'audio-only' }
            ],
            value: settings.staticRenditions,
            includeEnvVars: true,
            allowedEnvValues: null,
            errors: settings.getErrors('staticRenditions')
        }) }}

<hr>
        {% set instructions %}
            {{ "Secure playback requires you use a signed key in your playback url."|t('mux') }} 
            <a href="https://docs.mux.com/guides/video/secure-video-playback#6-include-the-json-web-token-jwt-in-the-media-url" target="_blank">View Documentation</a>
        {% endset %}

        {# {{ forms.lightswitchField({
            id: 'muxSecurePlayback',
            name: 'muxSecurePlayback',
            label: 'Secure Playback <div class="info">%s</div>'|format(instructions),
            onLabel: 'Secure'|t('mux'),
            offLabel: 'Public'|t('mux'),
            suggestEnvVars: true,
            value: settings.muxSecurePlayback,
            on: settings.muxSecurePlayback,
        }) }} #}

        {{ forms.booleanMenuField({
            label: 'Secure Playback <div class="info">%s</div>'|format(instructions),
            id: 'muxSecurePlayback',
            name: 'muxSecurePlayback',
            yesLabel: 'Secure'|t('mux'),
            noLabel: 'Public'|t('mux'),
            includeEnvVars: true,
            value: settings.muxSecurePlayback,
        }) }}

<hr>
        <h3>{{ "Overlay/Watermark"|t('mux') }}</h3>

        {{ forms.autosuggestField({
            label: 'Watermark URL <div class="info">The URL of the watermark/overlay image. Valid file types for watermarks are <strong>.png</strong> and <strong>.jpg</strong>. Other file types such as <strong>.gif</strong>, <strong>.webp</strong>, and <strong>.svg</strong> are not supported at this time.</div>'|t('mux'),
            id: 'watermark_url',
            name: 'watermark_url',
            value: settings.watermark_url,
            suggestEnvVars: true,
        }) }}

        {{  forms.selectizeField({
            label: 'Vertical Align <div class="info">Where the vertical positioning of the overlay/watermark should begin from.</div>'|t('mux'),
            id: 'vertical_align',
            name: 'vertical_align',
            options: [
                { label: 'Top', value: 'top' },
                { label: 'Center', value: 'center' },
                { label: 'Bottom', value: 'bottom' }
            ],
            includeEnvVars: true,
            allowedEnvValues: null,
            value: settings.vertical_align,
            errors: settings.getErrors('vertical_align')
        }) }}

        {{ forms.autosuggestField({
            label: 'Vertical Margin <div class="info">The distance from the vertical_align starting point and the image\'s closest edge. Can be expressed as a percent (10%) or as a pixel value (100px). Negative values will move the overlay offscreen. In the case of \'middle\', a positive value will shift the overlay towards the bottom and and a negative value will shift it towards the top.</div>'|t('mux'),
            id: 'vertical_margin',
            name: 'vertical_margin',
            suggestEnvVars: true,
            value: settings.vertical_margin,
        }) }}
        
        {{  forms.selectizeField({
            label: 'Horizontal Align <div class="info">Where the horizontal positioning of the overlay/watermark should begin from.</div>'|t('mux'),
            id: 'horizontal_align',
            name: 'horizontal_align',
            options: [
                { label: 'Left', value: 'left' },
                { label: 'Middle', value: 'middle' },
                { label: 'Right', value: 'right' }
            ],
            includeEnvVars: true,
            allowedEnvValues: null,
            value: settings.horizontal_align,
            errors: settings.getErrors('horizontal_align')
        }) }}

        {{ forms.autosuggestField({
            label: 'Horizontal Margin <div class="info">The distance from the horizontal_align starting point and the image\'s closest edge. Can be expressed as a percent (10%) or as a pixel value (100px). Negative values will move the overlay offscreen. In the case of \'center\', a positive value will shift the image towards the right and and a negative value will shift it towards the left.</div>'|t('mux'),
            id: 'horizontal_margin',
            name: 'horizontal_margin',
            suggestEnvVars: true,
            value: settings.horizontal_margin,
        }) }}
        

        {{ forms.autosuggestField({
            label: 'Width <div class="info">How wide the overlay should appear. Can be expressed as a percent (10%) or as a pixel value (100px). If both width and height are left blank the width will be the true pixels of the image, applied as if the video has been scaled to fit a 1920x1080 frame. If height is supplied with no width, the width will scale proportionally to the height.</div>'|t('mux'),
            id: 'width',
            name: 'width',
            suggestEnvVars: true,
            value: settings.width,
        }) }}

        {{ forms.autosuggestField({
            label: 'Height <div class="info">How tall the overlay should appear. Can be expressed as a percent (10%) or as a pixel value (100px). If both width and height are left blank the height will be the true pixels of the image, applied as if the video has been scaled to fit a 1920x1080 frame. If width is supplied with no height, the height will scale proportionally to the width.</div>'|t('mux'),
            id: 'height',
            name: 'height',
            suggestEnvVars: true,
            value: settings.height,
        }) }}

        {{ forms.autosuggestField({
            label: 'Opacity <div class="info">How opaque the overlay should appear, expressed as a percent. (Default 100%)</div>'|t('mux'),
            id: 'opacity',
            name: 'opacity',
            suggestEnvVars: true,
            value: settings.opacity,
        }) }}

<hr>
    {% set webhookinfo %}
        Mux uses webhooks to let your application know when things happen asynchronously, outside of an API request cycle.
        <a href="https://docs.mux.com/guides/system/listen-for-webhooks" target="_blank">View Documentation</a>
    {% endset %}

    {% set copywebhook =  forms.copytext({
        id:'muxWebhookUrl',
        name: 'muxWebhookUrl',
        value:siteUrl ~ 'actions/mux/webhooks/mux-webhooks'
    }) %}

     {{ forms.field({
        label: 'Webhook <div class="info">%s</div>'|format(webhookinfo),
        name: 'muxWebhookUrl-Field',
    }, copywebhook) }}

    {% endnamespace %}

    {# include our JavaScript modules #}
    {{ parent() }}
{% endblock %}

{% block foot %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mp4SupportField = document.getElementById('settings-mp4Support');
            const staticRenditionsField = document.getElementById('settings-staticRenditions');
            
            if (mp4SupportField && staticRenditionsField) {
                // Function to check and show notification when static renditions is changed
                function checkStaticRenditionsSelection() {
                    const mp4Value = mp4SupportField.value;
                    const staticValue = staticRenditionsField.value;
                    
                    if (mp4Value !== 'none' && staticValue !== 'none') {
                        Craft.cp.displayNotification('notice', '{{ "Warning: MP4 Support is deprecated and should be set to \"None\" when using Static Renditions. Please set MP4 Support to \"None\" to use Static Renditions."|t("mux")|raw }}', {
                            icon: 'alert',
                            iconLabel: '{{ "Warning"|t("app") }}'
                        });
                        
                        // Reset static renditions to 'none'
                        staticRenditionsField.value = 'none';
                    }
                }
                
                // Function to check and show notification when mp4 support is changed
                function checkMp4SupportSelection() {
                    const mp4Value = mp4SupportField.value;
                    const staticValue = staticRenditionsField.value;
                    
                    if (mp4Value !== 'none' && staticValue !== 'none') {
                        Craft.cp.displayNotification('notice', '{{ "Warning: MP4 Support is deprecated and should be set to \"None\" when using Static Renditions. Please set MP4 Support to \"None\" to use Static Renditions."|t("mux")|raw }}', {
                            icon: 'alert',
                            iconLabel: '{{ "Warning"|t("app") }}'
                        });
                        
                        // Reset mp4 support to 'none'
                        mp4SupportField.value = 'none';
                    }
                }
                
                // Add event listeners
                staticRenditionsField.addEventListener('change', checkStaticRenditionsSelection);
                mp4SupportField.addEventListener('change', checkMp4SupportSelection);
            }
        });
    </script>
{% endblock %}
